{
  "name": "openjob-restful-api-v1",
  "version": "1.0.0",
  "description": "OpenJob RESTful API Versi 1",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "nodemon src/server.js",
    "migrate:up": "dotenv -e .env -- node-pg-migrate up --migration-file-language js --migrations-dir ./migrations",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down --migration-file-language js --migrations-dir ./migrations",
    "migrate:create": "dotenv -e .env -- node-pg-migrate create --migration-file-language js --migrations-dir ./migrations"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.8",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^7.1.1",
    "nodemon": "^3.1.9"
  }
}
